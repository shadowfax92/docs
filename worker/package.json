{
  "name": "docs-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node scripts/build.mjs && vitest run",
    "typecheck": "node scripts/build.mjs && tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "wrangler deploy --dry-run --no-bundle --outdir dist/public && wrangler deploy --config wrangler.catalog.toml --dry-run --no-bundle --outdir dist/catalog",
    "integration:serve": "node scripts/build.mjs && node scripts/integration-server.mjs",
    "integration:http": "node scripts/integration-http.mjs",
    "integration:browser": "node scripts/integration-browser.mjs",
    "dev": "wrangler dev --no-bundle",
    "dev:catalog": "wrangler dev --no-bundle --config wrangler.catalog.toml",
    "deploy": "node scripts/deploy.mjs all",
    "deploy:all": "node scripts/deploy.mjs all",
    "deploy:public": "node scripts/deploy.mjs public",
    "deploy:catalog": "node scripts/deploy.mjs catalog",
    "index:maintain": "node scripts/index-maintain.mjs",
    "test:operator": "node --test scripts/persistent-index-operator.test.mjs",
    "integration:persistent": "node scripts/persistent-index-native.mjs",
    "integration:scale": "node scripts/persistent-index-browser.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "esbuild": "0.28.2",
    "miniflare": "3.20250718.3",
    "playwright": "1.58.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "entities": "8.1.0",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.2",
    "re2js": "2.8.6",
    "unpdf": "1.8.1"
  }
}
