# Copy to .env only when it does not already exist; chmod 600 .env, then edit locally.
# Literal dotenv values, no shell expansion. Quote passwords containing # or spaces.
ALL_DOCS_PASSWORD=

# Leave this assignment absent: deploy:all generates and persists a 32-random-byte key once.
# Keep that generated key for redeploys/password changes. Never commit or print .env.
# CATALOG_SESSION_KEY=

# AUTH_TOKEN is already provisioned on the public Worker; it is never sent to catalog.
